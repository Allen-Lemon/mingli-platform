# 复制本文件为 .env 并修改，切勿将含真实密码的 .env 提交到代码仓库
# （.gitignore 已忽略 .env，.env.example 仅作模板保留）

# ===== 远程 MySQL 数据库连接信息（本 compose 不再启动数据库容器） =====
# 远程数据库主机地址（云数据库/RDS 连接地址或服务器 IP），必填
DB_HOST=your-remote-mysql-host
# 端口（默认 3306）
DB_PORT=3306
# 数据库名（需提前在远程库创建，或确保应用账号有建库权限）
DB_NAME=mingli
# 远程数据库账号（不一定是 root，按云厂商 / 应用实际账号填写）
DB_USERNAME=mingli_user
# 远程数据库密码（必填，生产务必用强密码）
DB_PASSWORD=change_me_to_a_strong_password
